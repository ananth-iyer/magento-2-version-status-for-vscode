{
	"name": "magento-2-version-in-vscode",
	"displayName": "Magento 2 version in VSCode",
	"description": "Check Magento 2 in VS Code",
	"publisher": "ananth-iyer",
	"version": "0.0.5",
	"engines": {
		"vscode": "^1.138.0"
	},
    "sponsor": {
        "url": "https://github.com/sponsors/anant-svc"
    },
	"categories": [
		"Other"
	],
	"icon": "icon.png",
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./out/extension.js",
    "contributes": {
        "commands": [
        {
            "command": "magento-2-version-in-vscode.copyVersion",
            "title": "Copy Magento/MageOS Version"
        }
        ]
    },
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"pretest": "npm run compile && npm run lint",
		"lint": "eslint src",
		"test": "vscode-test"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/ananth-iyer/magento-2-version-status-for-vscode.git"
	},
	"devDependencies": {
		"@types/vscode": "^1.138.0",
        "@types/mocha": "^10.0.10",
        "@types/node": "24.x",
        "typescript-eslint": "^8.61.1",
        "eslint": "^10.5.0",
        "typescript": "^6.0.3",
        "@vscode/test-cli": "^0.0.15",
        "@vscode/test-electron": "^3.0.0"
	},
	"overrides": {
		"debug": "^4.4.3",
        "serialize-javascript": "^7.0.6"
	}
}
